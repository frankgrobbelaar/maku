{
  "name": "maku",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "tauri": "tauri",
    "check": "biome check && tsc && vitest run",
    "lint": "biome check",
    "fix": "biome check --write",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:engine": "uv run --directory ../engine pyinstaller maku-engine.spec --noconfirm",
    "build:notices": "uv run --directory ../engine python tools/third_party_notices.py",
    "build:installer-notes": "node ../scripts/installer-notes.mjs src-tauri/target/BEFORE-YOU-INSTALL.txt",
    "build:installer": "tauri build --config src-tauri/tauri.bundle.conf.json"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@tanstack/react-query": "^5.104.3",
    "@tauri-apps/api": "^2.12.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.59.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
